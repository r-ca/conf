#compdef nanoka

_nanoka() {
  local commands=("list" "run" "add" "help")
  local -a scripts
  local context state line

  for f in "$SCRIPT_DIR"/*.sh(N); do
    [[ -f $f ]] || continue
    scripts+=( "${f:t:r}" ) 
  done

  _arguments -C \
    '1:command:->command' \
    '2:script name:->script' \
    '3:command name:->add_command' \
    '*::args:->args'

  case "$state" in
    command)
      _describe 'command' commands
      ;;
    script)
      case "${words[2]}" in
        run)
          _describe 'script' scripts
          ;;
        add)
          _message 'new script name'
          ;;
      esac
      ;;
    add_command)
      if [[ "${words[2]}" == "add" ]]; then
        _command_names
      else
        _default
      fi
      ;;
    args)
      _default
      ;;
  esac
}

# _nanoka "$@"
