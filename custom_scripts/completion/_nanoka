#compdef nanoka

_nanoka() {
  local commands=("list" "run" "add" "help")
  local -a scripts
  local -a subcommands
  local context state line

  for f in "$SCRIPT_DIR"/*.sh(N); do
    [[ -f $f ]] || continue
    scripts+=( "${f:t:r}" ) 
  done

  subcommands=( "${commands[@]}" "${scripts[@]}" )

  _arguments -C \
    '1:subcommand:->command' \
    '2:argument:->subcommand_arg' \
    '*::args:->args'

  case "$state" in
    command)
      _describe 'subcommand' subcommands
      ;;
    subcommand_arg)
      case "${words[2]}" in
        run)
          _describe 'script' scripts
          ;;
        add)
          _message 'new script name'
          ;;
        *)
          _default
          ;;
      esac
      ;;
    args)
      case "${words[2]}" in
        add)
          if (( CURRENT == 4 )); then
            _command_names
          else
            _default
          fi
          ;;
        *)
          _default
          ;;
      esac
      ;;
  esac
}

# _nanoka "$@"
